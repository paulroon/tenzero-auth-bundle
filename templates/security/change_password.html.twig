{% extends '@TenZeroAuth/tenzero_base.html.twig' %}

{% block title %}{{ title|default('Change Password') }}{% endblock %}

{% block body %}
<div class="w-full max-w-sm">
    <div class="flex flex-col items-center justify-center mb-4">
        <h1 class="text-2xl font-bold tracking-tight text-gray-900">
            {{ title|default('Change Password') }}
        </h1>
    </div>

    {% include '@TenZeroAuth/security/_errors.html.twig' with {
        errors: errors|default([]),
        flashes: app is defined ? app.flashes('error') : []
    } only %}

    {% if tokenInvalid|default(false) %}
        <p class="mt-4 text-center text-sm text-gray-600">
            <a
                href="{{ path('tenzero_auth_forgot_password') }}"
                class="font-medium text-[var(--primary)] hover:text-[var(--primary-hover)]"
            >
                Request a new reset link
            </a>
        </p>
    {% else %}
        <form class="mt-8 space-y-6" action="{{ formAction|default(path('tenzero_auth_change_password')) }}" method="post">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token(csrfId|default('change_password')) }}">

            <div class="space-y-4">
                {% if showOldPassword|default(false) %}
                <div>
                    <label for="old_password" class="sr-only">
                        Current Password
                    </label>
                    <input
                        id="old_password"
                        name="old_password"
                        type="password"
                        required
                        class="block w-full rounded-md border-0 py-2.5 px-3 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-blue-600 sm:text-sm sm:leading-6"
                        placeholder="Current Password"
                    />
                </div>
                {% endif %}
                <div>
                    <label for="new_password" class="sr-only">
                        New Password
                    </label>
                    <input
                        id="new_password"
                        name="new_password"
                        type="password"
                        required
                        class="block w-full rounded-md border-0 py-2.5 px-3 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-blue-600 sm:text-sm sm:leading-6"
                        placeholder="New Password"
                    />
                </div>
                <div>
                    <label for="confirm_new_password" class="sr-only">
                        Confirm Password
                    </label>
                    <input
                        id="confirm_new_password"
                        name="confirm_new_password"
                        type="password"
                        required
                        class="block w-full rounded-md border-0 py-2.5 px-3 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-blue-600 sm:text-sm sm:leading-6"
                        placeholder="Confirm Password"
                    />
                </div>
            </div>

            <div>
                <button type="submit" class="tz-auth-btn">Update Password</button>
            </div>
        </form>
    {% endif %}

    <p class="mt-4 text-center text-sm text-gray-600">
        Back to
        <a
            href="{{ path('tenzero_auth_login') }}"
            class="font-medium text-[var(--primary)] hover:text-[var(--primary-hover)]"
        >
        Log In
        </a>
    </p>
</div>
{% endblock %}
