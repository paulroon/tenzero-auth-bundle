{% extends '@TenZeroAuth/tenzero_base.html.twig' %}

{% block title %}Forgot Password{% endblock %}

{% block body %}
    <div class="w-full max-w-sm">
        <div class="flex flex-col items-center justify-center mb-4">
            <h1 class="text-2xl font-bold tracking-tight text-gray-900">
                Reset Password
            </h1>
        </div>
        <form class="mt-8 space-y-6" action="{{ path('tenzero_auth_forgot_password') }}" method="post">
            <div class="space-y-4">
                {% include '@TenZeroAuth/security/_errors.html.twig' with {
                    errors: errors|default([]),
                    flashes: app is defined ? app.flashes('error') : []
                } only %}
                {% if app is defined %}
                    {% set successMessages = app.flashes('success') %}
                {% endif %}
                {% if successMessages is defined and successMessages|length > 0 %}
                    <div class="rounded-md border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-700">
                        <ul class="list-disc space-y-1 pl-5">
                            {% for message in successMessages %}
                                <li>{{ message }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password') }}">
                <div>
                    <label for="{{ userField }}" class="sr-only">
                        {{ userField|capitalize }}
                    </label>
                    <input
                        id="{{ userField }}"
                        name="{{ userField }}"
                        type="{% if userField is same as('email') %}email{% else %}text{% endif %}"
                        required
                        class="block w-full rounded-md border-0 py-2.5 px-3 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-blue-600 sm:text-sm sm:leading-6"
                        placeholder="{{ userField|capitalize }}"
                        />
                </div>
            </div>

            <div>
                <button type="submit" class="tz-auth-btn">Send Reset Link</button>
            </div>
        </form>

        <p class="mt-4 text-center text-sm text-gray-600">
            Remember your password?
            <a
                href="{{ path('tenzero_auth_login') }}"
                class="font-medium text-[var(--primary)] hover:text-[var(--primary-hover)]"
            >
            Log In
            </a>
        </p>
    </div>
{% endblock %}
