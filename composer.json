{
    "name": "happycode/tenzero-auth",
    "description": "Tenzero Auth bundle for Symfony",
    "type": "symfony-bundle",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Happycode\\TenZeroAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Happycode\\TenZeroAuth\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Paul Rooney",
            "email": "paulroon@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "doctrine/orm": "^2.17 || ^3.0",
        "lexik/jwt-authentication-bundle": "^3.2",
        "ramsey/uuid": "^4.9"
    },
    "require-dev": {
        "php-cs-fixer/shim": "^3.93",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5",
        "doctrine/doctrine-bundle": "^2.13 || ^3.0"
    },
    "archive": {
        "exclude": [
            "/.github",
            "/.idea",
            "/.php-cs-fixer.cache",
            "/.php-cs-fixer.dist.php",
            "/.gitattributes",
            "/.gitignore",
            "/composer.lock",
            "/docs",
            "/phpstan.neon",
            "/phpunit.xml",
            "/tests",
            "/vendor"
        ]
    },
    "config": {
        "audit": {
            "ignore": [
                "PKSA-365x-2zjk-pt47",
                "PKSA-b35n-565h-rs4q",
                "PKSA-rqvm-b18n-vg69"
            ]
        }
    }
}
