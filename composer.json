{
    "name": "happycode/tenzero-auth",
    "description": "Some Auth",
    "type": "symfony-bundle",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Happycode\\TenZeroAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Happycode\\TenZeroAuth\\Tests\\": "tests/"
        }
